# Dockerfile（无额外脚本）
FROM ubuntu:latest

# 1. 换源+装软件
RUN sed -i 's|http://archive.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list

RUN apt-get update && \
    apt-get install -y --no-install-recommends openssh-server sudo curl vim && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. 创建用户
RUN echo "root:123456" | chpasswd

RUN useradd -m -s /bin/bash visitor && \
    echo "visitor:VisitorPass123" | chpasswd

# 3. sshd 配置
RUN mkdir -p /var/run/sshd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#UseDNS yes/UseDNS no/' /etc/ssh/sshd_config && \
    echo 'PubkeyAcceptedAlgorithms +ssh-rsa,ssh-rsa-cert-v01@openssh.com' >> /etc/ssh/sshd_config

# 4. 修复 root 家目录权限（777 会导致 SSH 拒绝 authorized_keys）
RUN chmod 700 /root

# 5. 前台启动（无外部脚本）
CMD ["/usr/sbin/sshd", "-D"]

EXPOSE 22